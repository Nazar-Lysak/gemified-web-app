{
  "name": "gemified-web-app",
  "cdn-link": "https://nazar-lysak.github.io/gemified-web-app/cdn/gemifiedWebApp.iife.js",
  "cdn-use-demo": "https://nazar-lysak.github.io/gemified-web-app-cdn/index.html",
  "standalone-link": "https://nazar-lysak.github.io/gemified-web-app/standalone/",
  "demo-link": "https://nazar-lysak.github.io/gemified-web-app/demo/index.html",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.md\" \"vite-config/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.md\" \"vite-config/**/*.ts\"",
    "preview": "vite preview",
    "build:cdn": "vite build --config vite-config/vite.cdn.config.ts",
    "build:standalone": "vite build --config vite-config/vite.standalone.config.ts",
    "build:demo": "vite build --config vite-config/vite.demo.config.ts",
    "build:all": "run-p build:cdn build:standalone build:demo",
    "preview:cdn": "serve . -p 3000",
    "clean": "rimraf dist",
    "deploy": "npm run build:all && gh-pages -d dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "html-react-parser": "^5.2.17",
    "i18next": "^26.0.10",
    "motion": "^12.34.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.7",
    "react-player": "^3.4.0",
    "react-shadow": "^20.6.0",
    "styled-components": "^6.3.9",
    "styled-normalize": "^8.1.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
